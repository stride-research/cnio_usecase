# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
venv/

# Secrets — never commit
.env
.env.*
*.env
# ...except the committed template documenting which vars exist. Must come after the
# patterns above, and must re-whitelist explicitly: `.env.*` would otherwise swallow
# `.env.example` itself.
!.env.example
!**/.env.example

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Run artifacts (ad-hoc runs, not committed -- see e2e/1_sync/PARITY_REPORT.md for how
# to reproduce parity directly against the cluster instead of trusting a frozen copy).
# Was briefly committed as a "frozen baseline" under this same path; that copy went
# stale (held pre-PYTHONPATH-fix numbers) and nothing caught it, which is exactly the
# risk of committing large generated output -- removed, not just going forward but
# retroactively, in favor of re-running when parity needs re-checking.
runs/
slurm_logs/
reports/
*.jsonl
e2e/1_sync/original/results/
e2e/1_sync/adapted/results/
e2e/1_sync/temp/results/
